<?xml version="1.0" encoding="UTF-8"?>
<!--
  Findings SpotBugs reports that are so by design, each with its reason
  (RULES.md R-LINT-3).
-->
<FindBugsFilter>
  <!-- The reader reads a body it is given and never changes it; copying a
       body of up to 16 MiB for each reply would cost as much as reading it. -->
  <Match>
    <Class name="com.turborel.jdbc.internal.codec.Reader"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- A duplex hands out the streams and the socket it reads and writes,
       and takes the socket it is made of: that is what it is for. -->
  <Match>
    <Package name="com.turborel.jdbc.internal.transport"/>
    <Or>
      <Bug pattern="EI_EXPOSE_REP"/>
      <Bug pattern="EI_EXPOSE_REP2"/>
    </Or>
  </Match>
  <!-- The tests' scripted duplex hands out the stream it records, as a
       duplex does. -->
  <Match>
    <Class name="com.turborel.jdbc.internal.session.Script"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <!-- The tests name /tmp for Unix sockets, whose paths must be shorter
       than SUN_LEN, which macOS's temporary directory is not, and the
       name of a Windows named pipe, refused off Windows; the settings'
       tests read paths as settings' text, never opening them. -->
  <Match>
    <Or>
      <Class name="com.turborel.jdbc.internal.transport.TransportTest"/>
      <Class name="com.turborel.jdbc.testing.LiveServer"/>
      <Class name="com.turborel.jdbc.internal.settings.SettingsTest"/>
    </Or>
    <Bug pattern="DMI_HARDCODED_ABSOLUTE_FILENAME"/>
  </Match>
  <!-- A statement's results hold lists they copied unmodifiable, and a
       failure that is the program's to read; a connection hands out the
       views of itself that run its statements, control its session and
       tell what the server told: that is what they are for. -->
  <Match>
    <Or>
      <Class name="com.turborel.jdbc.internal.session.Batch"/>
      <Class name="com.turborel.jdbc.internal.session.Outcome$Rows"/>
      <Class name="com.turborel.jdbc.internal.session.Ran"/>
      <Class name="com.turborel.jdbc.internal.session.Connection"/>
      <Class name="com.turborel.jdbc.internal.session.Import$Cause"/>
    </Or>
    <Or>
      <Bug pattern="EI_EXPOSE_REP"/>
      <Bug pattern="EI_EXPOSE_REP2"/>
    </Or>
  </Match>
  <!-- Settings hand out their SCRAM key cache, shared by every
       connection they make, so a reconnection skips the derivation:
       that is what it is for. -->
  <Match>
    <Class name="com.turborel.jdbc.internal.settings.Settings"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <!-- A pipeline's failed outcome holds the failure, the program's to
       read; its queued executions hold the values they copied; a pooled
       connection hands out the connection it lends: that is what each is
       for. -->
  <Match>
    <Or>
      <Class name="com.turborel.jdbc.internal.session.Pipeline$Piped$Failed"/>
      <Class name="com.turborel.jdbc.internal.session.Pipeline$Queued$Execute"/>
      <Class name="com.turborel.jdbc.internal.session.Pooled"/>
    </Or>
    <Or>
      <Bug pattern="EI_EXPOSE_REP"/>
      <Bug pattern="EI_EXPOSE_REP2"/>
    </Or>
  </Match>
  <!-- A JDBC object hands out what JDBC says it hands out: a statement
       its connection and result set, a result set its statement, each
       its warnings, the metadata its connection, a data source the log
       writer it was given. -->
  <Match>
    <Or>
      <Class name="com.turborel.jdbc.JdbcStatement"/>
      <Class name="com.turborel.jdbc.JdbcResultSet"/>
      <Class name="com.turborel.jdbc.JdbcConnection"/>
      <Class name="com.turborel.jdbc.JdbcDatabaseMetaData"/>
      <Class name="com.turborel.jdbc.TurborelDataSource"/>
    </Or>
    <Or>
      <Bug pattern="EI_EXPOSE_REP"/>
      <Bug pattern="EI_EXPOSE_REP2"/>
    </Or>
  </Match>
  <!-- JDBC's names: a driver's class is called Driver, as java.sql's
       interface is, and JDBC writes setAutoCommit and getURL where the
       low-level client and a data source write setAutocommit and
       getUrl. -->
  <Match>
    <Or>
      <Class name="com.turborel.jdbc.Driver"/>
      <Class name="com.turborel.jdbc.JdbcConnection"/>
      <Class name="com.turborel.jdbc.JdbcDatabaseMetaData"/>
    </Or>
    <Bug pattern="NM_SAME_SIMPLE_NAME_AS_INTERFACE,NM_CONFUSING"/>
  </Match>
  <!-- A prepared statement prepares its SQL as it is made, so a refusal
       leaves the constructor; the class has no finalizer and is the
       package's own, so nothing can reach the object half made. -->
  <Match>
    <Class name="com.turborel.jdbc.JdbcPreparedStatement"/>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>
  <!-- The JDBC tests call a method in assertThrows for its failure, so
       no result is made to close or read, and they run SQL they build of
       their own tables' names and values. -->
  <Match>
    <Class name="~com\.turborel\.jdbc\.(Live.*|Objects)Test.*"/>
    <Or>
      <Bug pattern="RV_RETURN_VALUE_IGNORED"/>
      <Bug pattern="RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT"/>
      <Bug pattern="OBL_UNSATISFIED_OBLIGATION"/>
      <Bug pattern="ODR_OPEN_DATABASE_RESOURCE"/>
      <Bug pattern="SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE"/>
    </Or>
  </Match>
  <!-- These tests read column 0 and set parameter 0 to see them refused. -->
  <Match>
    <Class name="~com\.turborel\.jdbc\.(EdgesTest|LiveJdbcStatementTest).*"/>
    <Or>
      <Bug pattern="SQL_BAD_RESULTSET_ACCESS"/>
      <Bug pattern="SQL_BAD_PREPARED_STATEMENT_ACCESS"/>
    </Or>
  </Match>
  <Match>
    <Class name="com.turborel.jdbc.LiveJdbc"/>
    <Bug pattern="SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE"/>
  </Match>
</FindBugsFilter>
